import numpy as np
import tensorflow as tf
from music21 import converter

text = "CDEFGABcCDEFGABc"

chars = sorted(set(text))
d = {}

for i in range(len(chars)):
    d[chars[i]] = i

X = []
y = []

for i in range(len(text) - 2):
    a = d[text[i]]
    b = d[text[i + 1]]
    c = d[text[i + 2]]

    X.append([a, b])
    y.append(c)

X = np.array(X)
y = np.array(y)

model = tf.keras.Sequential([
    tf.keras.layers.Embedding(len(chars), 8),
    tf.keras.layers.SimpleRNN(16),
    tf.keras.layers.Dense(len(chars), activation="softmax")
])

model.compile(optimizer="adam",
              loss="sparse_categorical_crossentropy")

model.fit(X, y, epochs=10, verbose=0)

music = "X:1\nT:My Music\nM:4/4\nL:1/4\nK:C\nC D E F | G A B c |"

with open("music.abc", "w") as f:
    f.write(music)

score = converter.parse("music.abc")
score.write("midi", fp="music.mid")

print("Music saved!")
